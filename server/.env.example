# Copy this file to .env and fill in the values.

# Port the API listens on (the Vite dev server proxies /api here).
PORT=5000

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/Ai_Chat

# Your Anthropic API key (https://platform.claude.com/settings/keys).
# Leave empty to run in demo mode with sample replies.
ANTHROPIC_API_KEY=

# Optional: force a provider. "claude" or "mock". Defaults to claude when a key is set.
TIMBRE_PROVIDER=

# Optional Claude tuning (TIMBRE_ prefix avoids clashing with other tools' env vars).
TIMBRE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (low keeps chat replies fast)
TIMBRE_EFFORT=low
TIMBRE_MAX_TOKENS=64000
# Server-side refusal fallback (re-runs a declined request on a fallback model). true | false
TIMBRE_FALLBACKS=true

# Allowed browser origin for CORS in development.
CLIENT_ORIGIN=http://localhost:5173
