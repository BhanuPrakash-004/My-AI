# Copy this file to .env and fill in the values.
# Variables already set in your shell or hosting platform take priority over this file.

# Port the API listens on (the Vite dev server proxies /api here).
PORT=5000

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/Ai_Chat

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# claude  -> Anthropic Claude API (official @anthropic-ai/sdk)
# openai  -> OpenAI Chat Completions API, or any OpenAI-compatible server
AI_PROVIDER=claude

# API key for the provider above. Leave empty to run in demo mode (sample replies).
#   Claude: https://platform.claude.com/settings/keys
#   OpenAI: https://platform.openai.com/api-keys
AI_API_KEY=

# Optional base URL. Leave empty for the provider's official endpoint.
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://localhost:11434/v1        (no key needed)
#   Claude proxy / gateway: https://your-gateway.example.com
AI_BASE_URL=

# Model to use. Defaults: claude-opus-5-5 (claude), gpt-5-mini (openai).
AI_MODEL=claude-opus-5-5

# Optional: more models from the same provider for the model picker and Compare.
# Comma-separated, e.g. claude-sonnet-5-5,claude-haiku-5-5
AI_MODELS=

# ---------------------------------------------------------------------------
# Optional second provider for "Compare" (e.g. Claude vs OpenAI side by side).
# Leave COMPARE_PROVIDER empty to disable.
# ---------------------------------------------------------------------------
COMPARE_PROVIDER=
COMPARE_API_KEY=
COMPARE_BASE_URL=
COMPARE_MODEL=
COMPARE_MODELS=

# ---------------------------------------------------------------------------
# Claude-only tuning
# ---------------------------------------------------------------------------
AI_MAX_TOKENS=64000
# Server-side refusal fallback: if a safety classifier declines, the request is
# re-run on a fallback model in the same stream. true | false
AI_FALLBACKS=true

# Allowed browser origin for CORS in development.
CLIENT_ORIGIN=http://localhost:5173
